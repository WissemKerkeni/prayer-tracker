# A Postgres connection string. In local dev this is a Prisma Postgres
# "direct" connection; in production (e.g. Vercel) use the "pooled" one.
DATABASE_URL="postgres://user:pass@db.prisma.io:5432/postgres?sslmode=require"

# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"
